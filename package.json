{
  "name": "eduplus-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run db:seed",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "db:sync-access": "tsx scripts/sync-access.ts",
    "db:remote": "tsx scripts/db-remote.ts",
    "seed:production": "tsx scripts/seed-production.ts",
    "test": "node --test src/lib/",
    "test:contact": "tsx scripts/contact-access-test.ts",
    "test:i18n": "tsx scripts/i18n-test.ts",
    "test:ui": "tsx scripts/ui-test.ts",
    "test:periods": "tsx scripts/period-test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.62.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.2"
  }
}
