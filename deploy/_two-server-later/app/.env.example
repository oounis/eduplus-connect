# SERVER 1 (app) — copy to .env beside docker-compose.yml. Never commit it.
#
#   chmod 600 .env

# --- Database ---------------------------------------------------------------
# Through pgBouncer on server 2, over WireGuard.
#
#   pgbouncer=true      Prisma stops using named prepared statements, which
#                       transaction pooling cannot support. Without it you get
#                       intermittent "prepared statement s0 already exists".
#   connection_limit    PER REPLICA. 4 replicas x 8 = 32 client connections,
#                       which pgBouncer folds onto ~25 real backends.
DATABASE_URL="postgresql://eduplus:CHANGE_ME@10.10.10.2:6432/eduplus?schema=public&pgbouncer=true&connection_limit=8&pool_timeout=20"

# Straight to Postgres, bypassing the pooler. Migrations need a real session,
# so `prisma migrate deploy` uses this and nothing else does.
DIRECT_URL="postgresql://eduplus:CHANGE_ME@10.10.10.2:5432/eduplus?schema=public"

# --- Session ----------------------------------------------------------------
# The app REFUSES TO START in production if this is left at the example value
# or is shorter than 32 characters.
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"

# --- School -----------------------------------------------------------------
# Decides which period counts as "running now". The server runs in UTC.
SCHOOL_TIMEZONE="Asia/Bahrain"

# --- TLS --------------------------------------------------------------------
# Substituted into nginx/eduplus.conf. Must match the certificate.
SERVER_NAME="eduplus.example.com"
