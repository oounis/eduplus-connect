# SERVER 2 (database) — copy to .env beside docker-compose.yml. Never commit it.
#
#   chmod 600 .env

# --- Bind address -----------------------------------------------------------
# The WireGuard address of THIS server. Postgres and pgBouncer bind here and
# nowhere else, so neither is reachable from the internet.
#
# Setting this to 0.0.0.0 publishes the school's database to the world.
WG_ADDR="10.10.10.2"

# --- Credentials ------------------------------------------------------------
POSTGRES_USER="eduplus"
POSTGRES_PASSWORD="CHANGE_ME"     # openssl rand -base64 32
POSTGRES_DB="eduplus"

# --- Backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS="14"

# Offsite target for rclone. A backup on the same machine as the database
# survives a bad migration, not a lost server — set this.
#   RCLONE_REMOTE="contabo-s3:eduplus-backups"
RCLONE_REMOTE=""
