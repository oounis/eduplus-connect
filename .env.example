# ---------------------------------------------------------------------------
# Local development — SQLite file, no network needed
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Session signing secret (change this in any shared/hosted environment)
AUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"

# Seed password applied to every demo account
SEED_PASSWORD="Passw0rd!"

# ---------------------------------------------------------------------------
# Production — set these two and the app talks to Turso instead of the file.
# Nothing else changes; the schema is identical.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<database token>"
