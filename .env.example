# ---------------------------------------------------------------------------
# EduPlus Connect — configuration
#
# Copy to .env and fill in. NEVER commit a real .env: it holds the database
# password and the session signing key.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL in every environment, so a query cannot behave one way locally and
# another on the server.
#
# Local development (the docker-compose dev database):
DATABASE_URL="postgresql://eduplus:devpass@localhost:55432/eduplus?schema=public"
#
# Production: point at pgBouncer, not at Postgres directly, and bound the pool.
# `connection_limit` is per app process — keep (processes x limit) well under
# Postgres max_connections.
# DATABASE_URL="postgresql://eduplus:<password>@10.10.10.2:6432/eduplus?schema=public&connection_limit=10&pool_timeout=20"
#
# DIRECT_URL bypasses the pooler for migrations, which need a real session.
# DIRECT_URL="postgresql://eduplus:<password>@10.10.10.2:5432/eduplus?schema=public"

# --- Session ---------------------------------------------------------------
# Signs the session cookie. Minimum 32 characters. Generate a fresh one per
# environment with:  openssl rand -base64 48
# The app refuses to start in production if this is left at the dev value.
AUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"

# --- School ----------------------------------------------------------------
# Decides which period is "running now". The server runs in UTC; without this
# the app would unlock the wrong period. Any IANA timezone name.
SCHOOL_TIMEZONE="Asia/Bahrain"

# --- Seed ------------------------------------------------------------------
# Password applied to every demo account by `npm run db:seed`. Development
# only — the production seed asks for its own.
SEED_PASSWORD="Passw0rd!"

# --- Runtime ---------------------------------------------------------------
# PORT=3100
# NODE_ENV=production
